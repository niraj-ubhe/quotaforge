PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quotaforge
JWT_SECRET=replace-with-a-long-random-string
UPSTASH_REDIS_REST_URL=https://your-upstash-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
# Optional. Defaults to demo@quotaforge.dev. Not required for Explore Demo.
# DEMO_USER_EMAIL=demo@quotaforge.dev
# Optional password for the demo user if you also want normal /auth/login access.
# DEMO_USER_PASSWORD=
